@model LoginModel
@{ ViewData["Title"] = "Đăng nhập"; }
<div class="auth-layout"><section class="auth-story"><div><span class="eyebrow">CHÀO MỪNG ĐẾN VỚI AN TÂM</span><h2>Một kết nối.<br />Thêm sự an tâm.</h2><p>Lịch khám, thông báo và hồ sơ cá nhân được sắp xếp gọn gàng trong không gian dành riêng cho bạn.</p></div><div class="story-symbol" aria-hidden="true"><ui-icon name="heart" /></div><small><ui-icon name="shield" /> Bảo vệ thông tin, tôn trọng quyền riêng tư.</small></section>
<section class="auth-form"><span class="eyebrow">KHÔNG GIAN CỦA BẠN</span><h1>Đăng nhập</h1><p>Rất vui được gặp lại bạn. Hãy nhập thông tin tài khoản để tiếp tục.</p>
<form asp-action="Login" method="post"><input asp-for="ReturnUrl" type="hidden" /><div asp-validation-summary="ModelOnly" role="alert"></div>
@if (ViewData["TraceId"] is string trace) { <p class="auth-footnote">Mã hỗ trợ: @trace</p> }
<div class="field"><label asp-for="Username">Tên đăng nhập</label><input asp-for="Username" autocomplete="username" placeholder="Nhập tên đăng nhập" required maxlength="50" aria-describedby="username-error" /><span asp-validation-for="Username" id="username-error"></span></div>
<div class="field"><label asp-for="Password">Mật khẩu</label><div class="input-with-action"><input asp-for="Password" type="password" autocomplete="current-password" placeholder="Nhập mật khẩu" required maxlength="72" aria-describedby="password-error" /><button type="button" data-toggle-password="Password" aria-label="Hiện mật khẩu" aria-pressed="false"><ui-icon name="eye" /></button></div><span asp-validation-for="Password" id="password-error"></span></div>
<button class="btn btn-primary btn-full" type="submit">Đăng nhập <ui-icon name="arrow" /></button>
</form><p><a asp-action="Register">Chưa có tài khoản? Đăng ký ngay</a></p><p class="auth-footnote">Sử dụng tài khoản đã đăng ký hoặc được cơ sở y tế cấp.<br />Nếu cần hỗ trợ, vui lòng liên hệ nhân viên tiếp nhận.</p></section></div>
