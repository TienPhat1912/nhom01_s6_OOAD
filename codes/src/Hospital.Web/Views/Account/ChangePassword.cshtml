@model ChangePasswordModel
@{ ViewData["Title"] = "Đổi mật khẩu"; }
<div class="page-heading"><div><h1>Đổi mật khẩu</h1><p>Sau khi lưu, các phiên đăng nhập cũ sẽ hết hiệu lực.</p></div></div>
<section class="card narrow-card"><div class="card-body"><form asp-action="ChangePassword" method="post" data-confirm="Đổi mật khẩu và đăng nhập lại?">
<div asp-validation-summary="All" role="alert"></div>
@if (ViewData["TraceId"] is string trace) { <p>Mã hỗ trợ: @trace</p> }
<div class="field"><label asp-for="OldPassword">Mật khẩu hiện tại</label><input asp-for="OldPassword" type="password" autocomplete="current-password" required maxlength="72" /><span asp-validation-for="OldPassword"></span></div>
<div class="field"><label asp-for="NewPassword">Mật khẩu mới</label><input asp-for="NewPassword" type="password" autocomplete="new-password" required minlength="8" maxlength="72" aria-describedby="new-password-help" /><small id="new-password-help">8–72 ký tự, tối đa 72 byte UTF-8; khác mật khẩu hiện tại.</small><span asp-validation-for="NewPassword"></span></div>
<div class="field"><label asp-for="ConfirmPassword">Nhập lại mật khẩu mới</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required minlength="8" maxlength="72" /><span asp-validation-for="ConfirmPassword"></span></div>
<div class="form-footer"><a class="btn btn-secondary" asp-action="Profile">Về hồ sơ</a><button class="btn btn-primary" type="submit">Lưu mật khẩu</button></div>
</form></div></section>
