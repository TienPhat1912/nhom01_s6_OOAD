@model DashboardModel
@{ ViewData["Title"] = "Tổng quan"; var profile = Context.Items["Profile"] as UserProfileDto; var name = profile?.FullName ?? User.Identity?.Name; }
<div class="page-heading"><div><h1>Xin chào, @name <span aria-hidden="true">☀</span></h1><p>Chúc bạn một ngày nhiều sức khỏe và thật an tâm.</p></div><span class="badge"><ui-icon name="clock" />@Model.Period</span></div>
<section class="welcome-banner"><div><span class="eyebrow">AN TÂM ĐỒNG HÀNH</span><h2>@(User.IsInRole("Patient") ? "Dành thời gian cho sức khỏe của bạn" : "Bắt đầu ngày làm việc thật thuận lợi")</h2><p>@(User.IsInRole("Patient") ? "Kiểm tra lịch hẹn và cập nhật thông tin cá nhân để chuẩn bị tốt hơn cho mỗi lần thăm khám." : "Theo dõi thông tin trong phạm vi phụ trách, giữ mọi hoạt động được rõ ràng và nhất quán.")</p><a class="btn btn-primary btn-small" asp-controller="Account" asp-action="Profile">Xem hồ sơ cá nhân <ui-icon name="arrow" /></a></div><div class="banner-art" aria-hidden="true"><ui-icon name="calendar" /></div></section>
@if (User.IsInRole("Patient") || User.IsInRole("Staff")) { <div class="button-row filter-shortcuts"><a class="btn btn-primary" asp-controller="Booking" asp-action="Start">Đặt lịch khám <ui-icon name="arrow" /></a>@if (User.IsInRole("Staff")) { <a class="btn btn-secondary" asp-controller="Patients" asp-action="Index">Tìm bệnh nhân</a> }<a class="btn btn-secondary" asp-controller="Appointments" asp-action="Index" asp-route-fromDate="@DisplayText.Today.ToString("yyyy-MM-dd")" asp-route-toDate="@DisplayText.Today.ToString("yyyy-MM-dd")">Lịch hẹn hôm nay</a></div> }
<div class="stat-grid">@foreach (var stat in Model.Stats) { <article class="stat-card"><div class="stat-card-top"><span>@stat.Label</span><span class="stat-icon"><ui-icon name="@stat.Icon" /></span></div><strong class="stat-value">@stat.Value.ToString("N0")</strong><small>@stat.Description</small></article> }</div>
<div class="dashboard-columns"><section class="card"><div class="card-header"><div><h2>@(User.IsInRole("Admin") ? "Danh mục hệ thống" : "Lịch hẹn cần theo dõi")</h2><small>@Model.Period · Thông tin được cập nhật từ hệ thống</small></div>@if (!User.IsInRole("Admin")) { <a asp-controller="Appointments" asp-action="Index">Xem tất cả <ui-icon name="arrow" /></a> }</div>
@if (User.IsInRole("Admin")) { <div class="card-body"><p>Tra cứu đội ngũ bác sĩ và chuyên khoa. Sử dụng ứng dụng quản trị trên máy tính để quản lý dữ liệu hệ thống.</p><div class="button-row"><a class="btn btn-secondary" asp-controller="Catalog" asp-action="Index">Đội ngũ bác sĩ</a><a class="btn btn-secondary" asp-controller="Catalog" asp-action="Specialties">Chuyên khoa</a></div></div> }
else { <partial name="_AppointmentTable" model="Model.Appointments" /> }</section>
<aside class="tip-card"><ui-icon name="shield" /><h3>Một chút chuẩn bị,<br />thêm phần an tâm.</h3><p>Những điều nên kiểm tra trước mỗi lần thăm khám.</p><ol><li>Kiểm tra ngày, giờ và bác sĩ trong chi tiết lịch hẹn.</li><li>Mang giấy tờ cần thiết để đối chiếu tại quầy tiếp nhận.</li><li>Đọc các thông báo thay đổi liên quan đến lịch của bạn.</li></ol></aside></div>
