@model AppointmentListModel
@{ ViewData["Title"] = "Lịch hẹn"; }
<div class="page-heading"><div><h1>@(User.IsInRole("Patient") ? "Lịch hẹn của tôi" : "Danh sách lịch hẹn")</h1><p>Theo dõi thời gian khám và trạng thái lịch hẹn.</p></div></div>
<div class="button-row filter-shortcuts"><a class="btn btn-secondary btn-small" asp-action="Index" asp-route-fromDate="@DisplayText.Today.ToString("yyyy-MM-dd")" asp-route-toDate="@DisplayText.Today.ToString("yyyy-MM-dd")">Hôm nay</a><a class="btn btn-secondary btn-small" asp-action="Index" asp-route-fromDate="@DisplayText.Today.ToString("yyyy-MM-dd")" asp-route-status="Confirmed">Sắp tới</a><a class="btn btn-secondary btn-small" asp-action="Index" asp-route-toDate="@DisplayText.Today.AddDays(-1).ToString("yyyy-MM-dd")" asp-route-descending="true">Lịch sử</a><a class="btn btn-secondary btn-small" asp-action="Index">Tất cả</a></div>
<div asp-validation-summary="All" role="alert"></div>
<form method="get" class="toolbar filter-toolbar"><input type="hidden" name="doctorId" value="@Model.DoctorId" /><div class="field"><label for="keyword">Tìm lịch hẹn</label><input name="keyword" id="keyword" value="@Model.Keyword" placeholder="Mã lịch hẹn, họ tên hoặc số điện thoại" maxlength="100" /></div><div class="field"><label for="status">Trạng thái</label><select name="status" id="status"><option value="">Tất cả trạng thái</option>@foreach (var status in Enum.GetValues<AppointmentStatus>()) { <option value="@status" selected="@(Model.Status == status)">@DisplayText.Status(status)</option> }</select></div><div class="field"><label for="fromDate">Từ ngày</label><input type="date" id="fromDate" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" /></div><div class="field"><label for="toDate">Đến ngày</label><input type="date" id="toDate" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" /></div><div class="field"><label for="descending">Thứ tự</label><select id="descending" name="descending"><option value="false" selected="@(!Model.Descending)">Sớm nhất trước</option><option value="true" selected="@Model.Descending">Mới nhất trước</option></select></div><button class="btn btn-primary" type="submit"><ui-icon name="search" />Tìm kiếm</button></form>
@if (ViewData["DoctorName"] is string doctorName) { <p>Đang lọc theo bác sĩ: <strong>@doctorName</strong> · <a asp-action="Index">Bỏ lọc</a></p> }
<section class="card"><partial name="_AppointmentTable" model="Model.Page.Items" /><partial name="_Pagination" model="new Pagination(Model.Page.Page, Model.Page.TotalCount, Model.Page.PageSize)" /></section>
