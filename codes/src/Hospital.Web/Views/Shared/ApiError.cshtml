@model UiMessage
@{ ViewData["Title"] = Model.Title; }
<section class="legal-page"><span class="eyebrow">THÔNG TIN HỆ THỐNG</span><h1>@Model.Title</h1><partial name="_Message" model="Model" /><div class="button-row"><a class="btn btn-primary" href="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)">Thử lại <ui-icon name="refresh" /></a><a class="btn btn-secondary" asp-controller="Home" asp-action="Index">Về trang chủ</a></div></section>
