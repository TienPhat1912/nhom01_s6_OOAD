<dialog id="confirm-dialog" class="confirm-dialog" aria-labelledby="confirm-title" aria-describedby="confirm-description">
    <span class="empty-icon"><ui-icon name="shield" /></span>
    <h2 id="confirm-title">Xác nhận thay đổi</h2><p id="confirm-description"></p>
    <div class="button-row"><button class="btn btn-secondary" type="button" data-confirm-cancel autofocus>Hủy bỏ</button><button class="btn btn-primary" type="button" data-confirm-accept>Xác nhận</button></div>
</dialog>
