@model PagedResult<UserProfileDto>
@{ ViewData["Title"] = "Tìm bệnh nhân"; }
<div class="page-heading"><div><h1>Tìm bệnh nhân</h1><p>Chọn hồ sơ đã đăng ký để hỗ trợ đặt lịch. Đối chiếu họ tên, ngày sinh và số điện thoại trước khi chọn.</p></div></div>
<form method="get" class="toolbar"><input type="hidden" name="doctorId" value="@ViewData["DoctorId"]" /><input type="hidden" name="specialtyId" value="@ViewData["SpecialtyId"]" /><div class="field"><label for="keyword">Thông tin bệnh nhân</label><input id="keyword" name="keyword" value="@ViewData["Keyword"]" placeholder="Mã bệnh nhân, họ tên hoặc số điện thoại" maxlength="100" /></div><button class="btn btn-primary" type="submit">Tìm kiếm</button></form>
<section class="card">
@if (Model.Items.Count == 0) { <partial name="_EmptyState" model='new EmptyState("Chưa tìm thấy bệnh nhân", "Kiểm tra lại thông tin tìm kiếm. Bệnh nhân cần tự đăng ký tài khoản trước khi đặt lịch hộ.", "user")' /> }
else { <div class="table-scroll" role="region" aria-label="Kết quả tìm bệnh nhân" tabindex="0"><table class="data-table"><caption class="sr-only">Danh sách bệnh nhân</caption><thead><tr><th scope="col">Bệnh nhân</th><th scope="col">Ngày sinh</th><th scope="col">Số điện thoại</th><th scope="col">Thao tác</th></tr></thead><tbody>
@foreach (var patient in Model.Items) { <tr><td><strong>@patient.FullName</strong><small>@patient.PatientCode</small></td><td>@patient.DateOfBirth?.ToString("dd/MM/yyyy")</td><td>@(patient.PhoneNumber ?? "Chưa cập nhật")</td><td><a class="btn btn-primary btn-small" asp-controller="Booking" asp-action="Start" asp-route-patientId="@patient.PatientId" asp-route-doctorId="@ViewData["DoctorId"]" asp-route-specialtyId="@ViewData["SpecialtyId"]">Đặt lịch cho @patient.FullName</a></td></tr> }
</tbody></table></div> }
<partial name="_Pagination" model="new Pagination(Model.Page, Model.TotalCount, Model.PageSize)" /></section>
