@model PagedResult<DoctorDto>
@{ ViewData["Title"] = "Đội ngũ bác sĩ"; }
<div class="page-heading"><div><h1>Đội ngũ bác sĩ</h1><p>Tìm hiểu thông tin và chuyên khoa của bác sĩ.</p></div><a class="btn btn-secondary" asp-action="Specialties">Xem chuyên khoa</a></div>
@if (ViewData["SpecialtyName"] is string specialtyName) { <p>Chuyên khoa: <strong>@specialtyName</strong> · <a asp-action="Index">Tất cả chuyên khoa</a></p> }
<form method="get" class="toolbar"><input type="hidden" name="specialtyId" value="@ViewData["SpecialtyId"]" /><div class="field"><label for="keyword">Tìm bác sĩ</label><input id="keyword" name="keyword" value="@ViewData["Keyword"]" placeholder="Nhập tên hoặc mã bác sĩ" maxlength="100" /></div><button class="btn btn-primary" type="submit"><ui-icon name="search" />Tìm kiếm</button></form>
@if (Model.Items.Count == 0) { <div class="card"><partial name="_EmptyState" model='new EmptyState("Chưa tìm thấy bác sĩ", "Thử một tên khác hoặc thay đổi tiêu chí tìm kiếm.", "users")' /></div> }
else { <div class="catalog-grid">@foreach (var doctor in Model.Items) { <article class="card doctor-card"><span class="avatar">@DisplayText.Initials(doctor.FullName)</span><h2>@doctor.FullName</h2><p>@doctor.Title</p><span class="badge">@string.Join(" · ", doctor.Specialties)</span><p>@doctor.Bio</p><a class="btn btn-secondary btn-small" asp-action="Doctor" asp-route-id="@doctor.Id">Xem thông tin <ui-icon name="arrow" /></a></article> }</div> }
<partial name="_Pagination" model="new Pagination(Model.Page, Model.TotalCount, Model.PageSize)" />
