@model DoctorDetailDto
@{ ViewData["Title"] = "Thông tin bác sĩ"; }
<div class="page-heading"><div><span class="eyebrow">@Model.DoctorCode</span><h1>@Model.FullName</h1><p>@Model.Title</p></div><a class="btn btn-secondary" asp-action="Index">Về danh sách bác sĩ</a></div>
<div class="detail-grid"><section class="card"><div class="card-header"><h2>Thông tin giới thiệu</h2></div><div class="card-body"><span class="avatar avatar-large">@DisplayText.Initials(Model.FullName)</span><h3>@Model.FullName</h3><p>@(Model.Bio ?? "Bác sĩ chưa cập nhật thông tin giới thiệu.")</p><div class="button-row"><span class="badge">@Model.Specialty.Name</span></div></div></section><section class="card"><div class="card-header"><h2>Ngày có lịch trống</h2></div>@if (Model.AvailableDates.Count == 0) { <partial name="_EmptyState" model='new EmptyState("Chưa có ngày phù hợp", "Vui lòng quay lại khi lịch làm việc được cập nhật.")' /> } else { <div class="card-body"><p>Thông tin khả dụng tại thời điểm tra cứu. Việc xem lịch chưa giữ chỗ.</p><div class="button-row">@foreach (var date in Model.AvailableDates) { <span class="badge">@date.ToString("dd/MM/yyyy")</span> }</div></div> }</section></div>

@if (User.IsInRole("Patient") || User.IsInRole("Staff")) { <section class="card action-panel"><div class="card-body"><h2>Đặt lịch cùng bác sĩ</h2><div class="button-row">@if (Model.Specialty.IsActive) { <a class="btn btn-primary" asp-controller="Booking" asp-action="Start" asp-route-doctorId="@Model.Id" asp-route-specialtyId="@Model.SpecialtyId">Đặt lịch @Model.Specialty.Name</a> } @if (User.IsInRole("Staff")) { <a class="btn btn-secondary" asp-controller="Appointments" asp-action="Index" asp-route-doctorId="@Model.Id">Xem lịch hẹn của bác sĩ</a> }</div></div></section> }
