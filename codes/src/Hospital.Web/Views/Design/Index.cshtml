@{ ViewData["Title"] = "Thư viện giao diện"; }
<div class="design-page"><span class="eyebrow">AN TÂM · DESIGN SYSTEM</span><h1>Thư viện thành phần</h1><p>Trang kiểm tra dành cho môi trường Development. Dữ liệu ở đây chỉ minh họa trạng thái giao diện; không gửi thay đổi nghiệp vụ.</p>
<div class="design-grid"><section class="card card-body"><h2>Nút & trạng thái</h2><div class="button-row"><button type="button" class="btn btn-primary" data-toggle-password="design-password" aria-label="Hiện mật khẩu">Hiện mật khẩu</button><button class="btn btn-secondary" disabled title="Chưa chọn khung giờ">Chưa chọn khung giờ</button><button class="btn btn-primary" disabled><span class="spinner" aria-hidden="true"></span>Đang lưu…</button></div><h3>Trạng thái lịch hẹn</h3><div class="button-row">@foreach (var state in Enum.GetValues<AppointmentStatus>()) { <partial name="_StatusBadge" model="state" /> }</div></section>
<section class="card card-body"><h2>Biểu mẫu & xác nhận</h2><form data-confirm="Đây là hộp thoại kiểm tra. Không có dữ liệu nghiệp vụ được thay đổi." data-preview-form><div class="field"><label for="design-password">Mật khẩu minh họa</label><input id="design-password" type="password" value="example" /></div><div class="field"><label for="design-email">Email <span aria-hidden="true">*</span></label><input id="design-email" class="input-validation-error" type="email" aria-invalid="true" aria-describedby="design-error" required /><span class="field-validation-error" id="design-error">Vui lòng nhập địa chỉ email hợp lệ.</span></div><button class="btn btn-primary" type="submit">Kiểm tra xác nhận</button></form></section>
<section class="card card-body"><h2>Phản hồi thao tác</h2><partial name="_Message" model='new UiMessage("Đã lưu", "Thông tin đã được cập nhật.", "success")' /><partial name="_Message" model='new UiMessage("Chưa thể tải", "Vui lòng kiểm tra kết nối và thử lại.", "error", "MINH-HOA")' /></section>
<section class="card"><partial name="_EmptyState" model='new EmptyState("Chưa có lịch hẹn", "Chọn thời gian phù hợp để bắt đầu.")' /></section>
<section class="card card-body"><h2>Đang tải dữ liệu</h2><div role="status" aria-label="Đang tải danh sách"><div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div></div></section>
<section class="card card-body"><h2>Các bước thực hiện</h2><ol class="stepper" aria-label="Tiến trình minh họa"><li><span>1</span>Chuyên khoa</li><li aria-current="step"><span>2</span>Bác sĩ</li><li><span>3</span>Thời gian</li><li><span>4</span>Xác nhận</li></ol></section></div></div>
