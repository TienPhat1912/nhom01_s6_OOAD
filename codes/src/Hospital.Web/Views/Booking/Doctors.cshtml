@model BookingPage
@{ ViewData["Title"] = "Chọn bác sĩ"; }
<div class="page-heading"><div><h1>Chọn bác sĩ</h1><p>Chuyên khoa @Model.Specialty.Name</p></div><a class="btn btn-secondary" asp-action="Index" asp-route-context="@Model.Context">Đổi chuyên khoa</a></div>
<partial name="_Progress" model="2" /><partial name="_Patient" model="Model" />
<form method="get" class="toolbar"><input type="hidden" name="context" value="@Model.Context" /><input type="hidden" name="specialtyId" value="@Model.SpecialtyId" /><div class="field"><label for="keyword">Tìm bác sĩ</label><input id="keyword" name="keyword" value="@ViewData["Keyword"]" maxlength="100" /></div><button class="btn btn-secondary" type="submit">Tìm kiếm</button></form>
@if (Model.Doctors.Items.Count == 0) { <partial name="_EmptyState" model='new EmptyState("Chưa tìm thấy bác sĩ", "Thử tên khác hoặc chọn chuyên khoa khác.", "users")' /> }
else { <div class="catalog-grid">@foreach (var doctor in Model.Doctors.Items) { <article class="card doctor-card"><span class="avatar">@DisplayText.Initials(doctor.FullName)</span><h2>@doctor.FullName</h2><p>@doctor.Title</p><p>@doctor.Bio</p><a class="btn btn-primary" asp-action="Slots" asp-route-context="@Model.Context" asp-route-specialtyId="@Model.SpecialtyId" asp-route-doctorId="@doctor.Id">Chọn @doctor.FullName <ui-icon name="arrow" /></a></article> }</div> }
<partial name="_Pagination" model="new Pagination(Model.Doctors.Page, Model.Doctors.TotalCount, Model.Doctors.PageSize)" />
